# Dependencies (Nooit commiten, dit bouwt npm zelf op)
node_modules/
jspm_packages/
web_modules/

# Build outputs (De gecompileerde JavaScript-code)
dist/
build/
out/

# TypeScript specifieke bestanden (Gegenereerd door tsc bij incremental builds)
